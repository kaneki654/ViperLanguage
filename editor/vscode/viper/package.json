{
    "name": "viper-lang",
    "displayName": "Viper Language",
    "description": "Viper language support for VS Code and Cursor: syntax highlighting, smart autocompletion, hover docs, signature help, and live error diagnostics via the Viper LSP.",
    "version": "1.1.1",
    "publisher": "viper-lang",
    "license": "MIT",
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "viper",
                "aliases": [
                    "Viper",
                    "viper"
                ],
                "extensions": [
                    ".vp"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/viper.svg",
                    "dark": "./icons/viper.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "viper",
                "scopeName": "source.viper",
                "path": "./syntaxes/viper.tmLanguage.json"
            }
        ],
        "configuration": {
            "title": "Viper",
            "properties": {
                "viper.lspPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the viper executable (leave empty to use 'viper' from PATH)."
                }
            }
        }
    },
    "icon": "icons/viper.png",
    "main": "./out/extension.js",
    "activationEvents": [
        "onLanguage:viper"
    ]
}