{
    "name": "viper-lang",
    "displayName": "Viper Language",
    "description": "Syntax highlighting and editing support for the Viper language (.vp). Works in VS Code and Cursor.",
    "version": "1.0.0",
    "publisher": "viper-lang",
    "license": "MIT",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "viper",
                "aliases": [
                    "Viper",
                    "viper"
                ],
                "extensions": [
                    ".vp"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/viper.svg",
                    "dark": "./icons/viper.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "viper",
                "scopeName": "source.viper",
                "path": "./syntaxes/viper.tmLanguage.json"
            }
        ]
    },
    "icon": "icons/viper.png"
}