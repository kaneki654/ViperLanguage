# security.vp — CTF / authorized-testing helpers, all from the Viper stdlib.
# Everything here is offline and deterministic, so it runs anywhere.
# (Use these techniques only against systems you are allowed to test.)

# 1. "Crack" an unknown MD5 by hashing a small wordlist — a classic CTF task.
#    TARGET and WORDLIST never change, so they are const: reassigning them
#    anywhere below would be a compile-time error.
const TARGET = md5("hunter2")
const WORDLIST = ["password", "letmein", "hunter2", "admin", "qwerty"]
let cracked = None
for word in WORDLIST:
    if md5(word) == TARGET:
        cracked = word
        break
print("md5 target :", TARGET)
print("cracked    ->", cracked)

# 2. Decode a Base64 flag and hexdump the bytes.
let encoded = "ZmxhZ3t2MXBlcl9zdGRfbGlifQ=="
let flag = unb64(encoded) |> bytes.decode(_)
print("flag       :", flag)
print(hexdump(flag))

# 3. Verify a signed message with HMAC — detect tampering.
const KEY = "s3cret"
let message = "amount=100&to=alice"
let signature = hmac256(KEY, message)
print("hmac good  :", hmac256(KEY, message) == signature)
print("hmac tamper:", hmac256(KEY, "amount=999&to=eve") == signature)

# 4. Repeating-key XOR (classic CTF crypto) — reversible with the same key.
let cipher = xor("attack at dawn", KEY)
print("xor cipher :", to_hex(cipher))
print("xor back   :", xor(cipher, KEY) |> bytes.decode(_))

# 5. Pull a target apart like a web pentester would.
let parts = url_parse("https://victim.test:8443/login?next=/admin&debug=1")
print("host       :", parts["host"], "port", parts["port"])
print("query.next :", json_get(parts, "query.next"))

# 6. Fingerprint some data and mint a random token.
print("sha256     :", sha256(flag))
print("token      :", rand_token(8), "(fresh every run)")
