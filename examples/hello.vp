import math

let radius = 3

fn area(r: float) -> float:
    return math.pi * r ** 2

fn greet(name: str) -> str:
    return "Hello, " + name + "!"

let a = radius |> area
print(greet("Viper"))
print("circle area:")
print(a)

for n in [1, 2, 3]:
    match n:
        case 1:
            print("one")
        case _:
            print(n)

let square = fn(x) -> x * x
print(square(5))
